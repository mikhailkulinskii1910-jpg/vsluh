<resources>
    <style name="Theme.Irbis" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:alertDialogTheme">@style/Theme.Term.Dialog</item>
        <!-- Системный экран запуска — чёрный, дальше сразу наша заставка с крысой -->
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>

    <!-- Тема «Призма»: чёрный фон, переливающееся стекло, радужные блики -->
    <style name="Theme.Prism" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/prism_bg</item>
        <item name="android:statusBarColor">@color/prism_bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">#B49CFF</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:alertDialogTheme">@style/Theme.Prism.Dialog</item>
        <item name="android:windowSplashScreenBackground">@color/prism_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>

    <style name="Theme.Thermal" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/thermal_bg</item>
        <item name="android:statusBarColor">@color/thermal_bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">#FFD43B</item>
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:alertDialogTheme">@style/Theme.Thermal.Dialog</item>
        <item name="android:windowSplashScreenBackground">@color/thermal_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>

    <style name="Theme.Blueprint" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/blueprint_bg</item>
        <item name="android:statusBarColor">@color/blueprint_bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:alertDialogTheme">@style/Theme.Blueprint.Dialog</item>
        <item name="android:windowSplashScreenBackground">@color/blueprint_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
