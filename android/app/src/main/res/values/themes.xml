<resources>
    <color name="bg">#000000</color>
    <color name="prism_bg">#07060B</color>
    <color name="thermal_bg">#050308</color>
    <color name="blueprint_bg">#1A4A9E</color>
    <color name="icon_bg">#59646C</color>
    <style name="Theme.Irbis" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:alertDialogTheme">@style/Theme.Term.Dialog</item>
    </style>
    <!-- Диалоги в стиле терминала: чёрный фон, тонкая рамка, моноширинный шрифт -->
    <style name="Theme.Term.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:textColorPrimary">#EDEDED</item>
        <item name="android:textColorSecondary">#9E9E9E</item>
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Тема «Призма»: чёрный фон, переливающееся стекло, радужные блики -->
    <style name="Theme.Prism" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/prism_bg</item>
        <item name="android:statusBarColor">@color/prism_bg</item>
        <item name="android:navigationBarColor">@color/prism_bg</item>
        <item name="android:colorAccent">#B49CFF</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:alertDialogTheme">@style/Theme.Prism.Dialog</item>
    </style>
    <style name="Theme.Prism.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_prism</item>
        <item name="android:colorBackground">#120F1C</item>
        <item name="android:colorAccent">#B49CFF</item>
        <item name="android:textColorPrimary">#F4F1FF</item>
        <item name="android:textColorSecondary">#A79FC6</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Тема «Тепловизор»: чёрный кадр, палитра ironbow, жёлтые рамки обнаружения -->
    <style name="Theme.Thermal" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/thermal_bg</item>
        <item name="android:statusBarColor">@color/thermal_bg</item>
        <item name="android:navigationBarColor">@color/thermal_bg</item>
        <item name="android:colorAccent">#FFD43B</item>
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:alertDialogTheme">@style/Theme.Thermal.Dialog</item>
    </style>
    <style name="Theme.Thermal.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_thermal</item>
        <item name="android:colorBackground">#0A0508</item>
        <item name="android:colorAccent">#FFD43B</item>
        <item name="android:textColorPrimary">#FFF1DC</item>
        <item name="android:textColorSecondary">#E0974A</item>
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Тема «Чертёж»: синий blueprint, белые линии, Manrope -->
    <style name="Theme.Blueprint" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/blueprint_bg</item>
        <item name="android:statusBarColor">@color/blueprint_bg</item>
        <item name="android:navigationBarColor">@color/blueprint_bg</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:alertDialogTheme">@style/Theme.Blueprint.Dialog</item>
    </style>
    <style name="Theme.Blueprint.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_blueprint</item>
        <item name="android:colorBackground">#123E86</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#BFD3F2</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
