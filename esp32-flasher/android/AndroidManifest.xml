<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.vsluh.esp32flasher"
    android:versionCode="18"
    android:versionName="2.7">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="29" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- Раздел «Файлы на карте»: связь с платой по Wi-Fi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <!-- «Управление телефоном»: показ экрана на плате -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Нажатия с платы выполняет отдельное дополнение «ESP32 Flasher: нажатия»; команды ему —
         только от приложений с этой подписью -->
    <permission android:name="ru.vsluh.esp32flasher.permission.CONTROL" android:protectionLevel="signature" />
    <uses-permission android:name="ru.vsluh.esp32flasher.permission.CONTROL" />

    <application
        android:label="ESP32 Flasher"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Открываться при подключении платы и сразу получать доступ к USB -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
        <activity
            android:name=".CastActivity"
            android:label="Экран на плату"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PreviewActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode" />
        <service
            android:name=".ControlService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
