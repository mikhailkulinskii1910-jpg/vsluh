void drawSegTop(Surface& s, int o) {
  int w = 140;
  rrectX(s, 16, o + 12, w * 2 + 8, 34, 17, C_PANEL, C_PANEL, 255, 255, C_BORDER, 255);
  bool files = rScr == R_FILES;
  rr(s, files ? 20 + w + 4 : 20, o + 15, w, 28, 14, C_EQ, 255);
  textC(s, F_SB, 20 + w / 2, capBase(F_SB, o + 15, 28), "Справочник", files ? C_DIM : C_WHITE);
  textC(s, F_SB, 24 + w + w / 2, capBase(F_SB, o + 15, 28), "Мои файлы", files ? C_WHITE : C_DIM);
}

#define ROW_H 58
void drawRefList(Surface& s, int top) {
  int o = -top;
  for (int i = 0; i < REF_N; i++) {
    int y = o + PAGE_TOP + i * ROW_H - scrollY;
    if (y + ROW_H < 0 || y > s.h) continue;
    rrectX(s, 16, y, 288, ROW_H - 8, 14, C_PANEL, C_PANEL, 255, 255, C_BORDER, 255);
    rr(s, 26, y + 9, 32, 32, 10, C_EQ, 120);
    char num[4];
    snprintf(num, sizeof num, "%d", i + 1);
    textC(s, F_SB, 42, capBase(F_SB, y + 9, 32), num, C_ACCENT);
    drawText(s, F_SB, 70, y + 22, REF_PAGES[i].title, C_WHITE);
    drawText(s, F_X, 70, y + 39, REF_PAGES[i].sub, C_DIM);
    iconChevronR(s, 290, y + 25, 5, C_DIM);
  }
}

void drawMultTable(Surface& s, int y0) {
  int cell = 28, x0 = 13;
  for (int r = 0; r <= 10; r++)
    for (int c = 0; c <= 10; c++) {
      int x = x0 + c * cell, y = y0 + r * cell;
      if (y + cell < 0 || y > s.h) continue;
      bool head = r == 0 || c == 0;
      if (r == 0 && c == 0) { textC(s, F_X, x + cell / 2, capBase(F_X, y, cell), "×", C_ACCENT); continue; }
      int v = head ? (r == 0 ? c : r) : r * c;
      uint16_t bg = head ? mix565(C_PANEL, C_EQ, 120) : (r == c ? mix565(C_PANEL, C_EQ, 50) : ((r + c) % 2 ? C_PANEL : MK565(30, 31, 38)));
      rr(s, x + 1, y + 1, cell - 2, cell - 2, 5, bg, 255);
      textC(s, head ? F_SB : F_X, x + cell / 2, capBase(head ? F_SB : F_X, y, cell), std::to_string(v), head ? C_WHITE : C_DIGIT);
    }
}

void drawLines(Surface& s, int top, int y) {
  for (auto& l : rLines) {
    int yy = y;
    y += l.h;
    if (yy > s.h || yy + l.h < -30) continue;
    switch (l.kind) {
      case L_H1: drawText(s, F_T, TXT_X, yy + 21, l.text.c_str(), C_WHITE); break;
      case L_H2: drawText(s, F_SB, TXT_X, yy + 17, l.text.c_str(), C_ACCENT); break;
      case L_FORMULA:
        rrectX(s, TXT_X, yy, TXT_W, l.h - 4, 10, mix565(C_PANEL, C_EQ, 40), mix565(C_PANEL, C_EQ, 40), 255, 255, C_PANEL_BORDER, 200);
        drawText(s, F_SB, TXT_X + 12, yy + 19, l.text.c_str(), C_WHITE);
        break;
      case L_BULLET:
        discA(s, TXT_X + 4, yy + 11, 2.5f, C_ACCENT, 255);
        drawText(s, F_B, TXT_X + 14, yy + 15, l.text.c_str(), C_DIGIT);
        break;
      case L_NOTE: drawText(s, F_X, TXT_X + 4, yy + 12, l.text.c_str(), C_DIM); break;
      case L_MULT: drawMultTable(s, yy); break;
      case L_TEXT: {
        bool cont = !l.text.empty() && l.text[0] == '\x01';
        drawText(s, F_B, TXT_X + (cont ? 14 : 0), yy + 15, l.text.c_str() + (cont ? 1 : 0), C_DIGIT);
        break;
      }
      default: break;
    }
  }
  (void)top;
}

void drawFiles(Surface& s, int top) {
  int o = -top;
  int y0 = o + PAGE_TOP - scrollY;
  int x = 16;
  if (fDir != "/") {
    rrectX(s, 16, y0, 288, 40, 12, C_KEY, C_KEY, 255, 255, C_BORDER, 255);
    iconChevronL(s, 32, y0 + 20, 5, C_ACCENT);
    drawText(s, F_SB, 44, y0 + 25, ellipsize(F_SB, fDir, 240).c_str(), C_ACCENT);
    y0 += 48;
  }
  if (!fSdOk) {
    rrectX(s, 16, y0, 288, 248, 16, C_PANEL, C_PANEL, 255, 255, C_BORDER, 255);
    textC(s, F_SB, 160, y0 + 30, "Карта не читается", C_WHITE);
    std::string hint = sdMsg.empty() ? "Плата понимает только карты в формате FAT32. Карты на 64 ГБ и больше (SDXC) продаются в формате exFAT — их нужно переформатировать. Ещё проверьте, что карта вставлена до щелчка." : sdMsg;
    auto w = wrapText(F_X, hint, 260);
    for (size_t k = 0; k < w.size() && k < 7; k++) textC(s, F_X, 160, y0 + 54 + 16 * (int)k, w[k], C_DIM);
    rrectX(s, 30, y0 + 120 + 52, 260, 40, 12, sdFormatArmed ? MK565(90, 20, 36) : C_KEY, sdFormatArmed ? MK565(90, 20, 36) : C_KEY, 255, 255, sdFormatArmed ? C_CLEAR : C_BORDER, 255);
    textC(s, F_SB, 160, capBase(F_SB, y0 + 172, 40), sdFormatArmed ? "Точно? Все файлы удалятся" : "Отформатировать в FAT32", sdFormatArmed ? C_CLEAR : C_ACCENT);
    textC(s, F_X, 160, y0 + 228, "или нажмите сюда, чтобы проверить ещё раз", C_DIM);
    return;
  }
  if (fEnts.empty()) {
    rrectX(s, 16, y0, 288, 150, 16, C_PANEL, C_PANEL, 255, 255, C_BORDER, 255);
    textC(s, F_SB, 160, y0 + 34, "Здесь нет подходящих файлов", C_WHITE);
    const char* hint = "Положите на карту свои файлы TXT, HTML или картинки JPG и PNG — например, сохранённые страницы, конспекты или фото задач. Нажмите сюда, чтобы обновить список.";
    auto w = wrapText(F_X, hint, 260);
    for (size_t k = 0; k < w.size(); k++) textC(s, F_X, 160, y0 + 62 + 16 * (int)k, w[k], C_DIM);
    return;
  }
  for (size_t i = 0; i < fEnts.size(); i++) {
    int y = y0 + (int)i * 52;
    if (y + 52 < 0 || y > s.h) continue;
    const FileEnt& e = fEnts[i];
    rrectX(s, x, y, 288, 46, 12, C_PANEL, C_PANEL, 255, 255, C_BORDER, 255);
    int k = kindOf(e);
    uint16_t ic = k == 0 ? C_GOLD : k >= 3 ? MK565(110, 200, 255) : C_ACCENT;
    if (k == 0) iconFolder(s, 36, y + 23, ic); else if (k >= 3) iconImage(s, 36, y + 23, ic); else iconDoc(s, 36, y + 23, ic);
    drawText(s, F_SB, 58, y + 21, ellipsize(F_SB, e.name, 230).c_str(), C_WHITE);
    drawText(s, F_X, 58, y + 37, e.dir ? "папка" : (fmtBytes(e.size) + (k == 2 ? " · страница" : k >= 3 ? " · картинка" : " · текст")).c_str(), C_DIM);
  }
}

void drawRef(Surface& s, int top) {
  int o = -top;
  if (rScr == R_LIST || rScr == R_FILES) {
    s.cy0 = std::max(0, PAGE_TOP - 4 - top);
    if (rScr == R_LIST) drawRefList(s, top); else drawFiles(s, top);
    s.cy0 = 0;
    if (top < PAGE_TOP) { fillRectS(s, 0, o, SCREEN_W, PAGE_TOP - 4, C_BG); drawSegTop(s, o); }
    return;
  }
  // страница справочника, текст, картинка или HTML
  s.cy0 = std::max(0, 56 - top);
  if (rScr == R_HTML) {
    hv::Surface hs;
    hs.px = s.px; hs.w = s.w; hs.h = s.h;
    hs.cx0 = 0; hs.cx1 = s.w; hs.cy0 = s.cy0; hs.cy1 = s.h;
    if (hs.cy0 < hs.cy1) hv::drawStrip(hs, top - 56 + scrollY);
  } else if (rScr == R_IMAGE) {
    int y = o + 60 - scrollY;
    if (imgPx)
      for (int py = std::max(s.cy0, y); py < std::min(s.h, y + imgH); py++)
        memcpy(s.px + py * s.w + (SCREEN_W - imgW) / 2, imgPx + (py - y) * imgW, imgW * 2);
  } else drawLines(s, top, o + PAGE_TOP - scrollY);
  s.cy0 = 0;
  if (top < 56) {
    fillRectS(s, 0, o, SCREEN_W, 56, C_BG);
    drawHeader(s, o, rScr == R_PAGE || (rScr == R_HTML && !hv::history.empty()) ? "Назад" : "Файлы", "");
    textC(s, F_SB, 186, capBase(F_SB, o + 12, 32), ellipsize(F_SB, rTitle, 200), C_WHITE);
    fillRectS(s, 0, o + 55, SCREEN_W, 1, C_BORDER);
  }
  // полоса прокрутки
  if (scrollMax > 0) {
    int vh = TAB_Y - 60, bh = std::max(30, vh * vh / (vh + scrollMax)), by = 60 + (vh - bh) * scrollY / scrollMax;
    rr(s, SCREEN_W - 5, o + by, 3, bh, 1.5f, rScr == R_HTML && hv::doc.bg > 0x8410 ? MK565(120, 120, 130) : C_DIM, 140);
  }
}

void refSetScrollMax() {
  int vh = TAB_Y - PAGE_TOP;
  int h = 0;
  if (rScr == R_LIST) h = REF_N * ROW_H;
  else if (rScr == R_FILES) h = (fDir != "/" ? 48 : 0) + std::max(160, (int)fEnts.size() * 52);
  else if (rScr == R_IMAGE) h = imgH + 20;
  else if (rScr == R_HTML) { h = hv::doc.height; vh = TAB_Y - 56; }
  else h = linesHeight();
  scrollMax = std::max(0, h - vh);
  scrollY = std::max(0, std::min(scrollY, scrollMax));
}

// HTML и PNG открывает движок страниц (стили, картинки, ссылки)
void htmlSync() {  // после перехода по ссылке: заголовок и прокрутка из движка
  rTitle = hv::doc.title.empty() ? hv::fileName(hv::curUrl) : hv::doc.title;
  if (hv::curUrl.compare(0, 4, "dir:") == 0 && hv::doc.title.empty()) rTitle = hv::curUrl.substr(4);
  scrollY = hv::scrollY;
  refSetScrollMax();
  hv::scrollY = scrollY;
}
void openHtmlFile(const std::string& path) {
  if (!hv::init()) { parseMarkup("## Не хватило памяти\nЗакройте другие файлы и попробуйте ещё раз."); rTitle = "Ошибка"; rScr = R_TEXT; scrollY = 0; return; }
  hv::openFile(path);
  rScr = R_HTML;
  htmlSync();
}

void openTextFile(const FileEnt& e) {
  std::string path = (fDir == "/" ? "/" : fDir + "/") + e.name;
  std::string t = sdReadFile(path, 400000);
  if (!validUtf8(t)) t = fromCp1251(t);
  if (kindOf(e) == 2) t = htmlToMarkup(t);
  else {  // в обычном тексте не путаем строки с разметкой
    std::string r;
    size_t i = 0;
    while (i <= t.size()) {
      size_t j = t.find('\n', i);
      if (j == std::string::npos) j = t.size();
      std::string ln = t.substr(i, j - i);
      if (!ln.empty() && ln.back() == '\r') ln.pop_back();
      if (ln.size() >= 2 && (ln[0] == '#' || ln[0] == '=' || ln[0] == '-' || ln[0] == '!') && ln[1] == ' ') ln = " " + ln;
      r += ln + "\n";
      i = j + 1;
    }
    t = r;
  }
  if (kindOf(e) == 2 && t.size() < 80 && sdReadFile(path, 200000).find("<script") != std::string::npos)
    t = "## Это страница-программа\nВ файле почти нет текста: это игра или приложение на JavaScript (например, «Своя игра»). Плата показывает только текст и картинки, программы на ней не запускаются.\n- Откройте файл на телефоне или компьютере в браузере.\n- Чтобы видеть его и на плате, откройте файл в приложении ESP32 Flasher → «Экран на плату».";
  if (t.size() < 2) t = "! Файл пустой.";
  rTitle = e.name;
  parseMarkup(t);
  rScr = R_TEXT;
  scrollY = 0;
}

void refTap(int x, int y) {
  if (rScr == R_LIST || rScr == R_FILES) {
    if (y < PAGE_TOP) {
      if (y >= 10 && y < 50 && x >= 16 && x < 304) {
        uint8_t want = x < 160 ? R_LIST : R_FILES;
        if (want != rScr) { rScr = want; scrollY = 0; if (want == R_FILES) { sdForgetFail(); filesLoad(fDir); } }
      }
      return;
    }
    int cy = y - PAGE_TOP + scrollY;
    if (rScr == R_LIST) {
      int i = cy / ROW_H;
      if (i >= 0 && i < REF_N && cy % ROW_H < ROW_H - 8) {
        rPage = i;
        rTitle = REF_PAGES[i].title;
        parseMarkup(REF_PAGES[i].body);
        listScrollSave = scrollY;
        rScr = R_PAGE;
        scrollY = 0;
      }
      return;
    }
    if (fDir != "/") {
      if (cy < 44) { size_t sl = fDir.rfind('/'); filesLoad(sl == 0 ? "/" : fDir.substr(0, sl)); return; }
      cy -= 48;
    }
    if (!fSdOk) {
      if (cy >= 172 && cy < 212 && x >= 30 && x < 290) {  // кнопка форматирования: два нажатия
        if (!sdFormatArmed) { sdFormatArmed = true; return; }
        sdFormatArmed = false;
        sdMsg = sdFormat() ? "" : "Не получилось: плата не видит карту. Вставьте её до щелчка или отформатируйте в FAT32 на компьютере.";
        filesLoad("/");
        return;
      }
      sdFormatArmed = false;
      sdForgetFail();
      filesLoad(fDir);
      return;
    }
    if (fEnts.empty()) { sdForgetFail(); filesLoad(fDir); return; }
    int i = cy / 52;
    if (i < 0 || i >= (int)fEnts.size() || cy % 52 >= 46) return;
    const FileEnt& e = fEnts[i];
    int k = kindOf(e);
    listScrollSave = scrollY;
    if (k == 0) { filesLoad((fDir == "/" ? "/" : fDir + "/") + e.name); return; }
    if (k == 3) {
      std::string err;
      rTitle = e.name;
      if (openImage((fDir == "/" ? "/" : fDir + "/") + e.name, err)) { rScr = R_IMAGE; scrollY = 0; }
      else { parseMarkup("## Картинка не открылась\n" + err); rScr = R_TEXT; scrollY = 0; }
      return;
    }
    if (k == 2 || k == 4) { openHtmlFile((fDir == "/" ? "/" : fDir + "/") + e.name); return; }
    openTextFile(e);
    return;
  }
  if (y < 56 && x < 110) { refBack(); return; }
  if (rScr == R_HTML && y >= 56) {
    hv::scrollY = scrollY;
    if (hv::tapAt(x, y - 56 + scrollY)) htmlSync();
  }
}

void refBack() {
  if (rScr == R_PAGE) { rScr = R_LIST; scrollY = listScrollSave; }
  else if (rScr == R_HTML) {
    if (hv::goBack()) { htmlSync(); return; }
    hv::close();
    rScr = R_FILES; scrollY = listScrollSave;
  }
  else if (rScr == R_TEXT || rScr == R_IMAGE) { free(imgPx); imgPx = nullptr; rScr = R_FILES; scrollY = listScrollSave; rLines.clear(); }
}

