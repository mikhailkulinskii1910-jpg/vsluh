// Коды клавиш
enum KeyId : uint8_t {
  K_0, K_1, K_2, K_3, K_4, K_5, K_6, K_7, K_8, K_9,
  K_DOT, K_ADD, K_SUB, K_MUL, K_DIV, K_POW, K_SQR, K_PCT, K_LP, K_RP, K_SQRT, K_NEG, K_BS,
  K_C, K_EQ, K_MC, K_MR, K_MP, K_MM,
  K_SEG_MAIN, K_SEG_NUM, K_SEG_DEN, K_BULB, K_NONE = 255
};

enum : uint8_t { E_OK = 0, E_SYNTAX, E_DIV0, E_DOMAIN, E_OVER };
enum Target : uint8_t { TGT_MAIN, TGT_NUM, TGT_DEN };

// ===================== Типы =====================
// (все типы объявлены до первой функции — так требует генератор прототипов Arduino)
struct Glyph { uint16_t cp; uint8_t w, h; int8_t xo, yo; uint8_t adv; uint32_t off; };
struct AAFont { uint8_t* bits; const Glyph* g; uint16_t n; int8_t asc, desc; const char* b64; uint32_t nbytes; };

struct Surface {
  uint16_t* px = nullptr;
  int w = 0, h = 0, cap = 0;
  int cx0 = 0, cy0 = 0, cx1 = 0, cy1 = 0;  // область отсечения
};

// Элемент выражения: символ ('0'..'9', '.', '+', '-', '*', '/', '^', 's' = ², '%', '(', ')',
// 'r' = √, 'm' = унарный минус) или дробь ('F', f = номер дроби)
struct Item { char c; int8_t f; };
struct Part { Item it[PART_CAP]; uint8_t n; };
struct Frac { Part num, den; bool used; };
struct Field { Item* it; uint8_t* n; uint8_t cap; bool isMain; };

// Значение: точная дробь n/d или приближённое v
struct Val { bool exact; int64_t n, d; double v; bool pct; uint8_t err; };

struct Key { uint8_t id; int16_t x, y, w, h; };

struct TouchPt { int16_t x, y; };

struct Parser {
  const Item* it; int n; int p; uint8_t err;
  char peek() const { return p < n ? it[p].c : 0; }
  Val expr();
  Val term();
  Val unary();
  Val power();
  Val postfix();
  Val primary();
  Val number();
  Val fail(uint8_t e);
};

