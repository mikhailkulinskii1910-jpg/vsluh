uint32_t nowMs() { return millis(); }
void pushPixels(int x, int y, int w, int h, const uint16_t* px) { gfx->draw16bitRGBBitmap(x, y, (uint16_t*)px, w, h); }

void tcaWrite(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(TCA9554_ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}
void resetPanelAndTouch() {
  tcaWrite(0x01, 0xFF);
  tcaWrite(0x03, 0b11111000);  // P0 — сброс LCD, P1 — сброс тача, P2 — усилитель динамика
  tcaWrite(0x01, 0b11111000);
  delay(10);
  tcaWrite(0x01, 0b11111011);  // усилитель пока выключен
  delay(200);
}
void ampEnable(bool on) { tcaWrite(0x01, on ? 0xFF : 0b11111011); }

bool readTouch(TouchPt& t) {
  Wire.beginTransmission(FT6336_ADDR);
  Wire.write(0x02);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((uint8_t)FT6336_ADDR, (uint8_t)5) != 5) return false;
  uint8_t d[5];
  for (int i = 0; i < 5; i++) d[i] = Wire.read();
  uint8_t n = d[0] & 0x0F;
  if (n == 0 || n > 2) return false;
  int x = std::min(((d[1] & 0x0F) << 8) | d[2], SCREEN_W - 1), y = std::min(((d[3] & 0x0F) << 8) | d[4], SCREEN_H - 1);
  if (setFlip) { x = SCREEN_W - 1 - x; y = SCREEN_H - 1 - y; }
  t.x = x; t.y = y;
  return true;
}

// ---------- Звук щелчка: кодек ES8311 + I2S ----------
void esW(uint8_t reg, uint8_t v) { Wire.beginTransmission(ES8311_ADDR); Wire.write(reg); Wire.write(v); Wire.endTransmission(); }
uint8_t esR(uint8_t reg) {
  Wire.beginTransmission(ES8311_ADDR); Wire.write(reg); Wire.endTransmission(false);
  Wire.requestFrom((uint8_t)ES8311_ADDR, (uint8_t)1);
  return Wire.available() ? Wire.read() : 0;
}
void es8311Init() {
  esW(0x00, 0x1F); delay(20); esW(0x00, 0x00); esW(0x00, 0x80);
  esW(0x01, 0x3F | 0x80);
  esW(0x06, esR(0x06) & ~(1 << 5));
  esW(0x02, (esR(0x02) & 0x07) | (0 << 5) | (2 << 3));
  esW(0x03, (0 << 6) | 0x10); esW(0x04, 0x10); esW(0x05, 0x00);
  esW(0x06, (esR(0x06) & 0xE0) | (4 - 1));
  esW(0x07, esR(0x07) & 0xC0); esW(0x08, 0xFF);
  esW(0x00, esR(0x00) & 0xBF);
  esW(0x09, 4 << 2); esW(0x0A, 4 << 2);
  esW(0x0D, 0x01); esW(0x0E, 0x02); esW(0x12, 0x00); esW(0x13, 0x10); esW(0x1C, 0x6A); esW(0x37, 0x08);
  esW(0x32, 150);  // громкость
}
void beepClick() {
  if (!setSound) return;
  if (!audioReady) {
    es8311Init();
    i2s.setPins(PIN_I2S_BCLK, PIN_I2S_LRCK, PIN_I2S_DOUT, -1, -1);
    audioReady = i2s.begin(I2S_MODE_STD, 44100, I2S_DATA_BIT_WIDTH_32BIT, I2S_SLOT_MODE_STEREO, I2S_STD_SLOT_BOTH);
  }
  if (!audioReady) return;
  ampEnable(true);
  static int32_t buf[2 * 441];  // 10 мс
  for (int i = 0; i < 441; i++) {
    float env = expf(-i / 70.0f), v = sinf(i * 2 * 3.14159f * 2200 / 44100) * env * 9000;
    buf[2 * i] = buf[2 * i + 1] = (int32_t)((uint32_t)(int32_t)v << 16);
  }
  i2s.write((uint8_t*)buf, sizeof buf);
}

void applyBacklight() {
  int v = dimmed ? 8 : (int)(2.55f * setBright * setBright / 100.0f + 6);
  analogWrite(PIN_BL, std::min(255, v));
}

// ---------- SD-карта ----------
bool sdOk = false;
uint32_t sdFailT = 0;      // когда карта последний раз не ответила: повторяем не чаще раза в 5 с
uint32_t sdSizeMB = 0;
void sdForgetFail() { sdFailT = 0; }
bool sdBegin() {
  if (sdOk && SD.cardType() != CARD_NONE) return true;
  SD.end();
  // без карты каждая попытка занимает до секунды — не повторяем её на каждом кадре
  if (!sdOk && sdFailT && millis() - sdFailT < 5000) return false;
  sdOk = SD.begin(PIN_SD_CS, SPI, 20000000) || (SD.end(), SD.begin(PIN_SD_CS, SPI, 4000000));  // медленнее — для капризных карт
  sdFailT = sdOk ? 0 : (millis() | 1);
  if (sdOk) sdSizeMB = (uint32_t)(SD.cardSize() >> 20);
  return sdOk;
}
bool sdFormat() {  // FatFs форматирует только карту без понятной ей файловой системы (например, exFAT)
  SD.end();
  sdOk = SD.begin(PIN_SD_CS, SPI, 4000000, "/sd", 5, true);
  sdFailT = sdOk ? 0 : (millis() | 1);
  if (sdOk) sdSizeMB = (uint32_t)(SD.cardSize() >> 20);
  return sdOk;
}
void* jpgFileOpen(const char* name, int32_t* size) {
  if (!sdBegin()) return nullptr;
  File* f = new File(SD.open(name));
  if (!*f) { delete f; return nullptr; }
  *size = f->size();
  return f;
}
void jpgFileClose(void* h) { File* f = (File*)h; if (f) { f->close(); delete f; } }
int32_t jpgFileRead(JPEGFILE* jf, uint8_t* buf, int32_t len) { File* f = (File*)jf->fHandle; int32_t n = f->read(buf, len); jf->iPos = f->position(); return n; }
int32_t jpgFileSeek(JPEGFILE* jf, int32_t pos) { File* f = (File*)jf->fHandle; f->seek(pos); jf->iPos = pos; return pos; }
bool sdList(const std::string& dir, std::vector<FileEnt>& out) {
  if (!sdBegin()) return false;
  File d = SD.open(dir.c_str());
  if (!d || !d.isDirectory()) return false;
  File f;
  while ((f = d.openNextFile())) {
    std::string n = f.name();
    size_t sl = n.rfind('/');
    if (sl != std::string::npos) n = n.substr(sl + 1);
    out.push_back({ n, f.isDirectory(), (uint32_t)f.size() });
    f.close();
    if (out.size() > 400) break;
  }
  d.close();
  return true;
}
std::string sdReadFile(const std::string& path, size_t maxBytes) {
  std::string s;
  if (!sdBegin()) return s;
  File f = SD.open(path.c_str());
  if (!f) return s;
  size_t n = std::min((size_t)f.size(), maxBytes);
  s.resize(n);
  n = f.read((uint8_t*)&s[0], n);
  s.resize(n);
  f.close();
  return s;
}
bool sdReadBytes(const std::string& path, std::vector<uint8_t>& buf, size_t maxBytes) {
  if (!sdBegin()) return false;
  File f = SD.open(path.c_str());
  if (!f) return false;
  size_t n = f.size();
  if (n == 0 || n > maxBytes) { f.close(); return false; }
  buf.resize(n);
  bool ok = f.read(buf.data(), n) == n;
  f.close();
  return ok;
}

