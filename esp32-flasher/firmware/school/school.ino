    bool win = ttLine[0] >= 0 && (ttLine[0] == i || ttLine[1] == i || ttLine[2] == i);
    if (win) rr(s, cx - TT_C / 2.0f + 6, cy - TT_C / 2.0f + 6, TT_C - 12, TT_C - 12, 14, C_EQ, 120);
    if (tt[i] == 1) { capsuleS(s, cx - 22, cy - 22, cx + 22, cy + 22, 5, C_ACCENT); capsuleS(s, cx + 22, cy - 22, cx - 22, cy + 22, 5, C_ACCENT); }
    if (tt[i] == 2) ringS(s, cx, cy, 23, 8, C_GOLD);
  }
  std::string st = ttWin == 1 ? "Победили крестики! Нажмите, чтобы сыграть ещё" : ttWin == 2 ? "Победили нолики! Нажмите, чтобы сыграть ещё" : ttWin == 3 ? "Ничья. Нажмите, чтобы сыграть ещё" : (ttTurn == 1 ? "Ходят крестики" : "Ходят нолики");
  std::vector<std::string> lines = wrapText(F_SB, st, 290);
  for (size_t k = 0; k < lines.size(); k++) textC(s, F_SB, 160, o + TT_Y + TT_C * 3 + 32 + 20 * (int)k, lines[k], ttWin ? C_GOLD : C_WHITE);
}

void tttTap(int x, int y) {
  if (y < 56) { if (x < 90) gScr = G_MENU; else if (x >= 282) { ttNew(); ttScore[0] = ttScore[1] = ttScore[2] = 0; } return; }
  if (ttWin) { ttStarter = 3 - ttStarter; ttNew(); return; }
  int c = (x - TT_X) / TT_C, r = (y - TT_Y) / TT_C;
  if (x < TT_X || y < TT_Y || c > 2 || r > 2) return;
  int i = r * 3 + c;
  if (tt[i]) return;
  tt[i] = ttTurn;
  ttTurn = 3 - ttTurn;
  ttCheck();
}

