// ---------- Шахматы: экран ----------
int chView(int sq) {  // клетка → номер на экране (0 — левый верхний угол)
  int f = sq & 7, r = sq >> 3;
  bool flip = chAutoFlip && cs.side < 0;
  return flip ? (r * 8 + (7 - f)) : ((7 - r) * 8 + f);
}
int chFromView(int col, int row) {
  bool flip = chAutoFlip && cs.side < 0;
  return flip ? (row * 8 + (7 - col)) : ((7 - row) * 8 + col);
}

void drawChess(Surface& s, int top) {
  int o = -top;
  if (top < 60) {
    rightLimit = 204; drawHeader(s, o, "Игры", "Шахматы"); rightLimit = SCREEN_W - 16;
    headButton(s, 222, o + 28, 2, chAutoFlip ? C_ACCENT : C_DIM);
    headButton(s, 262, o + 28, 0, chHist.empty() ? C_BORDER : C_FUNC);
    headButton(s, 300, o + 28, 1, C_FUNC);
  }
  int kingInCheck = chInCheck(cs, cs.side) ? chKing(cs, cs.side) : -1;
  for (int sq = 0; sq < 64; sq++) {
    int v = chView(sq), col = v % 8, row = v / 8;
    int x = BX + col * SQ, y = o + BY + row * SQ;
    if (y > s.h || y + SQ < 0) continue;
    bool light = ((sq & 7) + (sq >> 3)) % 2 == 1;
    uint16_t c = light ? C_LIGHT : C_DARKSQ;
    if (sq == cs.lastFrom || sq == cs.lastTo) c = mix565(c, MK565(246, 220, 80), 110);
    if (sq == chSel) c = mix565(c, MK565(250, 230, 60), 170);
    rr(s, x, y, SQ, SQ, 0, c, 255);
    if (sq == kingInCheck) rrectX(s, x + 2, y + 2, SQ - 4, SQ - 4, SQ / 2, C_RED, C_RED, 190, 120, 0, 0);
    // подписи полей
    if (col == 0) { char b[2] = { (char)('1' + (sq >> 3)), 0 }; drawText(s, F_X, x + 2, y + 12, b, light ? C_DARKSQ : C_LIGHT); }
    if (row == 7) { char b[2] = { (char)('a' + (sq & 7)), 0 }; drawText(s, F_X, x + SQ - 9, y + SQ - 3, b, light ? C_DARKSQ : C_LIGHT); }
    drawPiece(s, cs.bd[sq], x + SQ / 2.0f, y + SQ / 2.0f + 1);
    if (chSel >= 0)
      for (auto& m : chLegal)
        if (m.from == chSel && m.to == sq && (m.promo == 0 || m.promo == 5)) {
          if (cs.bd[sq] || (m.flags & 2)) outlineA(s, x + 2, y + 2, SQ - 4, SQ - 4, SQ / 2, MK565(30, 30, 30), 150);
          else discA(s, x + SQ / 2.0f, y + SQ / 2.0f, 6, MK565(30, 30, 30), 90);
        }
  }
  outlineA(s, BX - 1, o + BY - 1, SQ * 8 + 2, SQ * 8 + 2, 2, C_BORDER, 255);
  // выбор фигуры для превращения пешки
  if (chPromoTo >= 0) {
    int v = chView(chPromoTo), col = v % 8;
    int x = BX + std::min(col, 4) * SQ - 4, y = o + BY + 3 * SQ - 10;
    rrectX(s, x, y, SQ * 4 + 8, SQ + 20, 12, C_PANEL, C_PANEL, 250, 250, C_ACCENT, 255);
    static const int8_t opts[4] = { 5, 4, 3, 2 };
    for (int k = 0; k < 4; k++) drawPiece(s, opts[k] * cs.side, x + 4 + SQ * k + SQ / 2.0f, y + 10 + SQ / 2.0f + 1);
  }
  // строка состояния
  int sy = o + BY + SQ * 8 + 10;
  if (sy < s.h && sy + 50 > 0) {
    static const char* const RES[6] = { "", "Мат! Победили белые", "Мат! Победили чёрные", "Пат — ничья", "Ничья: мало фигур", "Ничья: 50 ходов без взятий" };
    std::string st;
    uint16_t col = C_WHITE;
    if (chResult) { st = RES[chResult]; col = C_GOLD; }
    else {
      st = cs.side > 0 ? "Ход белых" : "Ход чёрных";
      if (kingInCheck >= 0) { st += " — шах!"; col = C_ERR; }
    }
    discA(s, 22, sy + 15, 8, cs.side > 0 ? C_WHITE : MK565(30, 30, 34), 255);
    outlineA(s, 14, sy + 7, 16, 16, 8, C_DIM, 255);
    drawText(s, F_SB, 38, sy + 20, st.c_str(), col);
    int d = chMaterial(1) - chMaterial(-1);
    std::string mat = d == 0 ? "Материал равный" : (d > 0 ? "Белые +" : "Чёрные +") + std::to_string(abs(d));
    drawText(s, F_X, 38, sy + 38, (mat + " · ход " + std::to_string(chHist.size() / 2 + 1)).c_str(), C_DIM);
  }
}

void chTap(int x, int y) {
  if (y < 56) {
    if (x < 90) { gScr = G_MENU; return; }
    if (x >= 205 && x < 240) chAutoFlip = !chAutoFlip;
    else if (x >= 244 && x < 281 && !chHist.empty()) { cs = chHist.back(); chHist.pop_back(); chSel = chPromoTo = -1; chUpdate(); }
    else if (x >= 282) chNew();
    return;
  }
  if (chPromoTo >= 0) {
    int v = chView(chPromoTo), col = v % 8;
    int px = BX + std::min(col, 4) * SQ - 4, py = BY + 3 * SQ - 10;
    if (y >= py && y < py + SQ + 20 && x >= px && x < px + SQ * 4 + 8) {
      static const int8_t opts[4] = { 5, 4, 3, 2 };
      int k = std::max(0, std::min(3, (x - px - 4) / SQ));
      for (auto& m : chLegal)
        if (m.from == chPromoFrom && m.to == chPromoTo && m.promo == opts[k]) { chHist.push_back(cs); cs = chApply(cs, m); break; }
      chUpdate();
    }
    chPromoTo = chPromoFrom = chSel = -1;
    return;
  }
  if (chResult) return;
  int col = (x - BX) / SQ, row = (y - BY) / SQ;
  if (x < BX || col > 7 || y < BY || row > 7) { chSel = -1; return; }
  int sq = chFromView(col, row);
  if (chSel >= 0) {
    for (auto& m : chLegal)
      if (m.from == chSel && m.to == sq) {
        if (m.promo) { chPromoFrom = chSel; chPromoTo = sq; return; }
        chHist.push_back(cs);
        cs = chApply(cs, m);
        chSel = -1;
        chUpdate();
        return;
      }
  }
  chSel = cs.bd[sq] * cs.side > 0 ? sq : -1;
}

// ---------- Шашки: экран ----------
int ckView(int sq) { int f = sq & 7, r = sq >> 3; return (7 - r) * 8 + f; }
bool ckPrefix(const CkMove& m) {
  if (m.n < ckPathN) return false;
  for (int i = 0; i < ckPathN; i++) if (m.path[i] != ckPath[i]) return false;
  return true;
}

void drawCheckers(Surface& s, int top) {
  int o = -top;
  if (top < 60) {
    rightLimit = 244; drawHeader(s, o, "Игры", "Шашки"); rightLimit = SCREEN_W - 16;
    headButton(s, 262, o + 28, 0, ckHist.empty() ? C_BORDER : C_FUNC);
    headButton(s, 300, o + 28, 1, C_FUNC);
  }
  bool mustCap = !ckMoves.empty() && ckMoves[0].nc > 0;
  uint64_t taken = 0, movable = 0, targets = 0;
  if (ckPathN)
    for (auto& m : ckMoves)
      if (ckPrefix(m)) {
        for (int i = 0; i < m.nc && i < ckPathN - 1; i++) taken |= 1ULL << m.caps[i];
        if (m.n > ckPathN) targets |= 1ULL << m.path[ckPathN];
      }
  for (auto& m : ckMoves) movable |= 1ULL << m.path[0];
  for (int sq = 0; sq < 64; sq++) {
    int v = ckView(sq), col = v % 8, row = v / 8;
    int x = BX + col * SQ, y = o + BY + row * SQ;
    if (y > s.h || y + SQ < 0) continue;
    bool dark = ((sq & 7) + (sq >> 3)) % 2 == 0;
    uint16_t c = dark ? C_CKDARK : C_CKLIGHT;
    if (dark && (sq == ks.lastFrom || sq == ks.lastTo)) c = mix565(c, MK565(200, 170, 60), 80);
    if (ckPathN && sq == ckPath[0]) c = mix565(c, MK565(240, 210, 70), 150);
    rr(s, x, y, SQ, SQ, 0, c, 255);
    int p = ks.b[sq];
    float cx = x + SQ / 2.0f, cy = y + SQ / 2.0f;
    if (ckPathN && sq == ckPath[0]) p = 0;  // шашка «в пути»
    if (ckPathN && sq == ckPath[ckPathN - 1]) p = ks.b[ckPath[0]];
    drawCkPiece(s, p, cx, cy, 14, (taken >> sq & 1) ? 90 : 255);
    if (!ckPathN && mustCap && (movable >> sq & 1) && ks.b[sq] * ks.side > 0) outlineA(s, cx - 17, cy - 17, 34, 34, 17, C_GOLD, 230);
    if (targets >> sq & 1) discA(s, cx, cy, 7, C_GOLD, 200);
  }
  outlineA(s, BX - 1, o + BY - 1, SQ * 8 + 2, SQ * 8 + 2, 2, C_BORDER, 255);
  int sy = o + BY + SQ * 8 + 10;
  if (sy < s.h && sy + 50 > 0) {
    std::string st;
    uint16_t col = C_WHITE;
    if (ckMoves.empty()) { st = ks.side > 0 ? "Победили чёрные!" : "Победили белые!"; col = C_GOLD; }
    else { st = ks.side > 0 ? "Ход белых" : "Ход чёрных"; if (mustCap) { st += " — бить обязательно"; col = C_GOLD; } }
    drawCkPiece(s, ks.side, 22, sy + 15, 8, 255);
    drawText(s, F_SB, 38, sy + 20, st.c_str(), col);
    std::string cnt = "Белых " + std::to_string(ckCount(1)) + " · чёрных " + std::to_string(ckCount(-1));
    drawText(s, F_X, 38, sy + 38, cnt.c_str(), C_DIM);
  }
}

void ckTap(int x, int y) {
  if (y < 56) {
    if (x < 90) { gScr = G_MENU; return; }
    if (x >= 244 && x < 281 && !ckHist.empty()) { ks = ckHist.back(); ckHist.pop_back(); ckPathN = 0; ckGen(ks, ckMoves); }
    else if (x >= 282) ckNew();
    return;
  }
  if (ckMoves.empty()) return;
  int col = (x - BX) / SQ, row = (y - BY) / SQ;
  if (x < BX || col > 7 || y < BY || row > 7) return;
  int sq = (7 - row) * 8 + col;
  if (ckPathN) {  // продолжение пути
    for (auto& m : ckMoves)
      if (ckPrefix(m) && m.n > ckPathN && m.path[ckPathN] == sq) {
        ckPath[ckPathN++] = sq;
        for (auto& f : ckMoves)  // путь закончен — делаем ход
          if (ckPrefix(f) && f.n == ckPathN) {
            ckHist.push_back(ks);
            ks = ckApply(ks, f);
            ckPathN = 0;
            ckGen(ks, ckMoves);
            return;
          }
        return;
      }
    if (ckPathN == 1) ckPathN = 0;  // другая шашка — выбор заново
    else return;                    // посреди взятия менять нельзя
  }
  for (auto& m : ckMoves) if (m.path[0] == sq) { ckPath[0] = sq; ckPathN = 1; return; }
}

