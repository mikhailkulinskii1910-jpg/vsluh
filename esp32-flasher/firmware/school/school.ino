// ---------- Разбор текста в строки ----------
#define TXT_X 16
#define TXT_W 288
#define PAGE_TOP 60

void addWrapped(uint8_t kind, const AAFont& f, const std::string& t, int w, int lh) {
  for (auto& l : wrapText(f, t, w)) rLines.push_back({ kind, (int16_t)lh, l });
}

void parseMarkup(const std::string& body) {
  rLines.clear();
  size_t i = 0;
  while (i <= body.size()) {
    size_t j = body.find('\n', i);
    if (j == std::string::npos) j = body.size();
    std::string ln = body.substr(i, j - i);
    i = j + 1;
    if (ln == "@mult") { rLines.push_back({ L_MULT, 300, "" }); continue; }
    if (ln.empty()) { rLines.push_back({ L_SPACE, 10, "" }); continue; }
    if (ln.compare(0, 3, "## ") == 0) { rLines.push_back({ L_SPACE, 6, "" }); addWrapped(L_H2, F_SB, ln.substr(3), TXT_W, 24); continue; }
    if (ln.compare(0, 2, "# ") == 0) { addWrapped(L_H1, F_T, ln.substr(2), TXT_W, 28); continue; }
    if (ln.compare(0, 2, "= ") == 0) { auto w = wrapText(F_SB, ln.substr(2), TXT_W - 24); for (size_t k = 0; k < w.size(); k++) rLines.push_back({ L_FORMULA, (int16_t)(k + 1 == w.size() ? 34 : 22), w[k] }); continue; }
    if (ln.compare(0, 2, "- ") == 0) { auto w = wrapText(F_B, ln.substr(2), TXT_W - 16); for (size_t k = 0; k < w.size(); k++) rLines.push_back({ (uint8_t)(k ? L_TEXT : L_BULLET), 21, (k ? "\x01" : "") + w[k] }); continue; }
    if (ln.compare(0, 2, "! ") == 0) { rLines.push_back({ L_SPACE, 6, "" }); addWrapped(L_NOTE, F_X, ln.substr(2), TXT_W - 20, 17); continue; }
    addWrapped(L_TEXT, F_B, ln, TXT_W, 21);
  }
  rLines.push_back({ L_SPACE, 20, "" });
}

int linesHeight() { int h = 0; for (auto& l : rLines) h += l.h; return h; }

// ---------- HTML → текст (для своих сохранённых страниц) ----------
static const uint16_t CP1251_HI[64] = {
  0x0402, 0x0403, 0x201A, 0x0453, 0x201E, 0x2026, 0x2020, 0x2021, 0x20AC, 0x2030, 0x0409, 0x2039, 0x040A, 0x040C, 0x040B, 0x040F,
  0x0452, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x0020, 0x2122, 0x0459, 0x203A, 0x045A, 0x045C, 0x045B, 0x045F,
  0x00A0, 0x040E, 0x045E, 0x0408, 0x00A4, 0x0490, 0x00A6, 0x00A7, 0x0401, 0x00A9, 0x0404, 0x00AB, 0x00AC, 0x00AD, 0x00AE, 0x0407,
  0x00B0, 0x00B1, 0x0406, 0x0456, 0x0491, 0x00B5, 0x00B6, 0x00B7, 0x0451, 0x2116, 0x0454, 0x00BB, 0x0458, 0x0405, 0x0455, 0x0457,
};
bool validUtf8(const std::string& s) {
  size_t i = 0, bad = 0, multi = 0;
  while (i < s.size()) {
    unsigned char c = s[i];
    if (c < 0x80) { i++; continue; }
    int n = c >= 0xF0 ? 3 : c >= 0xE0 ? 2 : c >= 0xC0 ? 1 : -1;
    if (n < 0 || i + n >= s.size() + (n ? 0 : 1)) { bad++; i++; continue; }
    bool ok = true;
    for (int k = 1; k <= n; k++) if (i + k >= s.size() || ((unsigned char)s[i + k] & 0xC0) != 0x80) ok = false;
    if (ok) { multi++; i += n + 1; } else { bad++; i++; }
  }
  return bad * 20 <= multi + 1;
}
std::string fromCp1251(const std::string& s) {
  std::string r;
  for (unsigned char c : s) {
    if (c < 0x80) r += (char)c;
    else if (c >= 0xC0) putUtf8(r, 0x410 + (c - 0xC0));
    else putUtf8(r, CP1251_HI[c - 0x80]);
  }
  return r;
}
std::string lowerAscii(std::string s) { for (auto& c : s) if (c >= 'A' && c <= 'Z') c += 32; return s; }

std::string htmlToMarkup(const std::string& h) {
  std::string out, cur;
  auto flush = [&](const char* prefix) {
    size_t a = cur.find_first_not_of(' ');
    if (a != std::string::npos) { size_t b = cur.find_last_not_of(' '); out += prefix; out += cur.substr(a, b - a + 1); out += '\n'; }
    cur.clear();
  };
  const char* pending = "";
  size_t i = 0;
  while (i < h.size()) {
    char c = h[i];
    if (c == '<') {
      size_t e = h.find('>', i);
      if (e == std::string::npos) break;
      std::string tag = lowerAscii(h.substr(i + 1, e - i - 1));
      bool close = !tag.empty() && tag[0] == '/';
      std::string name = tag.substr(close ? 1 : 0);
      size_t sp = name.find_first_of(" \t\r\n/");
      if (sp != std::string::npos) name = name.substr(0, sp);
      if (!close && (name == "script" || name == "style" || name == "head" || name == "noscript")) {
        size_t end = lowerAscii(h.substr(e)).find("</" + name);
        i = end == std::string::npos ? h.size() : e + end;
        continue;
      }
      if (name == "h1" || name == "h2" || name == "h3" || name == "h4") { flush(pending); pending = close ? "" : "## "; }
      else if (name == "li") { flush(pending); pending = close ? "" : "- "; }
      else if (name == "p" || name == "div" || name == "br" || name == "tr" || name == "table" || name == "ul" || name == "ol" || name == "section" || name == "article") { flush(pending); pending = ""; }
      else if (name == "td" || name == "th") cur += "  ";
      i = e + 1;
      continue;
    }
    if (c == '&') {
      size_t e = h.find(';', i);
      if (e != std::string::npos && e - i < 10) {
        std::string ent = h.substr(i + 1, e - i - 1);
        uint32_t cp = 0;
        if (ent == "nbsp") cp = ' '; else if (ent == "amp") cp = '&'; else if (ent == "lt") cp = '<'; else if (ent == "gt") cp = '>';
        else if (ent == "quot") cp = '"'; else if (ent == "laquo") cp = 0xAB; else if (ent == "raquo") cp = 0xBB;
        else if (ent == "mdash") cp = 0x2014; else if (ent == "ndash") cp = 0x2013; else if (ent == "hellip") cp = 0x2026;
        else if (ent == "times") cp = 0xD7; else if (ent == "minus") cp = 0x2212; else if (ent == "deg") cp = 0xB0;
        else if (!ent.empty() && ent[0] == '#') cp = (uint32_t)strtoul(ent.c_str() + (ent.size() > 1 && (ent[1] == 'x' || ent[1] == 'X') ? 2 : 1), nullptr, (ent.size() > 1 && (ent[1] == 'x' || ent[1] == 'X')) ? 16 : 10);
        if (cp) { putUtf8(cur, cp); i = e + 1; continue; }
      }
    }
    if (c == '\n' || c == '\r' || c == '\t') c = ' ';
    if (c == ' ' && !cur.empty() && cur.back() == ' ') { i++; continue; }
    cur += c;
    i++;
  }
  flush(pending);
  return out;
}

// ---------- SD-карта ----------
void refBack();
bool sdList(const std::string& dir, std::vector<FileEnt>& out);
std::string sdReadFile(const std::string& path, size_t maxBytes);
bool sdReadBytes(const std::string& path, std::vector<uint8_t>& buf, size_t maxBytes);
bool sdFormat();                      // FAT32 (только если карта не читается)
void* jpgFileOpen(const char* name, int32_t* size);  // чтение JPEG прямо с карты
void jpgFileClose(void* h);
int32_t jpgFileRead(JPEGFILE* f, uint8_t* buf, int32_t len);
int32_t jpgFileSeek(JPEGFILE* f, int32_t pos);
void sdForgetFail();                  // следующая попытка открыть карту — сразу, без паузы
bool sdFormatArmed = false;
std::string sdMsg;

int kindOf(const FileEnt& e) {  // 0 — папка, 1 — текст, 2 — HTML, 3 — картинка JPEG, 4 — PNG, −1 — прочее
  if (e.dir) return 0;
  std::string n = lowerAscii(e.name);
  auto ends = [&](const char* x) { size_t l = strlen(x); return n.size() >= l && n.compare(n.size() - l, l, x) == 0; };
  if (ends(".txt") || ends(".md")) return 1;
  if (ends(".htm") || ends(".html")) return 2;
  if (ends(".jpg") || ends(".jpeg")) return 3;
  if (ends(".png")) return 4;
  return -1;
}

void filesLoad(const std::string& dir) {
  fEnts.clear();
  std::vector<FileEnt> all;
  fSdOk = sdList(dir, all);
  for (auto& e : all) if (!e.name.empty() && e.name[0] != '.' && e.name != "System Volume Information" && kindOf(e) >= 0) fEnts.push_back(e);
  std::sort(fEnts.begin(), fEnts.end(), [](const FileEnt& a, const FileEnt& b) { if (a.dir != b.dir) return a.dir; return lowerAscii(a.name) < lowerAscii(b.name); });
  fDir = dir;
  scrollY = 0;
}

std::string fmtBytes(uint32_t b) {
  char buf[24];
  if (b < 1024) snprintf(buf, sizeof buf, "%u Б", (unsigned)b);
  else if (b < 1048576) snprintf(buf, sizeof buf, "%.1f КБ", b / 1024.0);
  else snprintf(buf, sizeof buf, "%.1f МБ", b / 1048576.0);
  std::string s = buf;
  for (auto& c : s) if (c == '.') c = ',';
  return s;
}

int jpegToBuf(JPEGDRAW* d) {
  int bw = d->iWidthUsed > 0 ? d->iWidthUsed : d->iWidth;
  for (int yy = 0; yy < d->iHeight; yy++) {
    int Y = d->y + yy;
    if (Y >= gJ.h) break;
    for (int xx = 0; xx < bw; xx++) { int X = d->x + xx; if (X < gJ.w) gJ.px[Y * gJ.w + X] = d->pPixels[yy * d->iWidth + xx]; }
  }
  return 1;
}

// Картинка на всю ширину экрана: декодируем с уменьшением, затем сглаженно ужимаем до 320 px
bool openImage(const std::string& path, std::string& err) {
  free(imgPx); imgPx = nullptr; imgW = imgH = 0;
  JPEGDEC* j = new JPEGDEC();
  bool ok = false;
  if (j->open(path.c_str(), jpgFileOpen, jpgFileClose, jpgFileRead, jpgFileSeek, jpegToBuf)) {  // большие фото с телефона не влезут в память целиком
    int orient = j->getOrientation();
    int W = j->getWidth(), H = j->getHeight(), s = 1;
    while (s < 8 && (W / (s * 2) >= SCREEN_W || (long)(W / s) * (H / s) > 700000L)) s *= 2;
    int w = W / s, h = H / s;
    uint16_t* tmp = w > 0 && h > 0 ? (uint16_t*)calloc((size_t)w * h, 2) : nullptr;
    if (tmp) {
      gJ.px = tmp; gJ.w = w; gJ.h = h;
      j->setPixelType(RGB565_LITTLE_ENDIAN);
      if (j->decode(0, 0, s == 2 ? JPEG_SCALE_HALF : s == 4 ? JPEG_SCALE_QUARTER : s == 8 ? JPEG_SCALE_EIGHTH : 0)) {
        if (orient == 3 || orient == 6 || orient == 8) {  // фото снято боком: поворачиваем по метке EXIF
          uint16_t* rot = (uint16_t*)malloc((size_t)w * h * 2);
          if (rot) {
            int nw = orient == 3 ? w : h, nh = orient == 3 ? h : w;
            for (int y = 0; y < h; y++)
              for (int x = 0; x < w; x++) {
                int nx, ny;
                if (orient == 3) { nx = w - 1 - x; ny = h - 1 - y; }
                else if (orient == 6) { nx = h - 1 - y; ny = x; }
                else { nx = y; ny = w - 1 - x; }
                rot[ny * nw + nx] = tmp[y * w + x];
              }
            free(tmp);
            tmp = rot; w = nw; h = nh;
          }
        }
        int ow = std::min(w, (int)SCREEN_W), oh = (int)((long)h * ow / w);
        imgPx = (uint16_t*)malloc((size_t)ow * oh * 2);
        if (imgPx) {
          float k = (float)w / ow;
          for (int y = 0; y < oh; y++)
            for (int x = 0; x < ow; x++) {
              int x0 = (int)(x * k), x1 = std::max(x0 + 1, (int)((x + 1) * k)), y0 = (int)(y * k), y1 = std::max(y0 + 1, (int)((y + 1) * k));
              uint32_t R = 0, G = 0, B = 0, n = 0;
              for (int yy = y0; yy < y1 && yy < h; yy++)
                for (int xx = x0; xx < x1 && xx < w; xx++) { uint16_t c = tmp[yy * w + xx]; R += c >> 11; G += (c >> 5) & 63; B += c & 31; n++; }
              imgPx[y * ow + x] = n ? (uint16_t)(((R / n) << 11) | ((G / n) << 5) | (B / n)) : 0;
            }
          imgW = ow; imgH = oh; ok = true;
        } else err = "Картинка слишком большая";
      } else err = "Этот JPEG не поддерживается (возможно, прогрессивный). Пересохраните картинку как обычный JPEG.";
      free(tmp);
    } else err = "Картинка слишком большая";
    j->close();
  } else err = "Файл не читается как JPEG. Если это скриншот, он, скорее всего, в формате PNG — сохраните его как JPG.";
  delete j;
  return ok;
}

