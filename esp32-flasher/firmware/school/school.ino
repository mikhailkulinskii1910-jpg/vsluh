void wifiApplyHome() {
  staUp = false;
  if (homeSsid.length()) {
    WiFi.mode(WIFI_AP_STA);  // точка доступа платы остаётся: к плате можно подключиться в любом случае
    WiFi.begin(homeSsid.c_str(), homePass.c_str());
  } else {
    WiFi.disconnect(false);
    WiFi.mode(WIFI_AP);
  }
  wifiInfoUpdate();
}
void handleShowUpload() {
  HTTPUpload& up = server.upload();
  if (up.status == UPLOAD_FILE_START) { castRx.clear(); castRx.reserve(200000); if (server.hasArg("mode")) castMode = server.arg("mode") == "ctl" ? 1 : 0; }
  else if (up.status == UPLOAD_FILE_WRITE) { if (castRx.size() + up.currentSize <= 900000) castRx.insert(castRx.end(), up.buf, up.buf + up.currentSize); }
  else if (up.status == UPLOAD_FILE_END) castReady = !castRx.empty();
}
void wifiEnable(bool on) {
  if (on == wifiOn) return;
  if (!on) {
    server.stop();
    if (mdnsUp) { MDNS.end(); mdnsUp = false; }
    staUp = false;
    WiFi.softAPdisconnect(true);
    WiFi.disconnect(true);
    WiFi.mode(WIFI_OFF);
    wifiOn = false;
    wifiInfo.clear();
    renderContent();
    return;
  }
  wifiOn = true;
  wifiInfo = "Включаю…";
  renderContent();
  prefs.begin("school", true);
  homeSsid = prefs.getString("wssid", "");
  homePass = prefs.getString("wpass", "");
  prefs.end();
  if (!homeSsid.length() && sdBegin()) {
    File cfg = SD.open("/wifi.txt");  // или своя сеть с карты: первая строка — имя, вторая — пароль
    if (cfg) { homeSsid = cfg.readStringUntil('\n'); homeSsid.trim(); homePass = cfg.readStringUntil('\n'); homePass.trim(); cfg.close(); }
  }
  WiFi.mode(homeSsid.length() ? WIFI_AP_STA : WIFI_AP);
  WiFi.softAP("ESP32-HTML", "12345678");
  WiFi.setSleep(false);  // без энергосбережения Wi-Fi: нажатия и кадры доходят без задержек
  wifiApplyHome();
  if (!serverStarted) {
    server.on("/__api/info", HTTP_GET, apiInfo);
    server.on("/__wifi", HTTP_POST, apiWifi);
    server.on("/__events", HTTP_GET, []() {
      bool was = castLinked();
      castPollT = millis();
      if (server.hasArg("mode")) castMode = server.arg("mode") == "ctl" ? 1 : 0;
      std::string j = castTakeEvents();
      sendJson(200, j.c_str());
      if (!was && castOn && !tDown) renderRegion(0, CAST_TOP, drawTab);  // зелёная точка: телефон на связи
    });
    server.on("/__show", HTTP_POST, []() { sendJson(200, "{\"ok\":true}"); }, handleShowUpload);
    server.onNotFound([]() { sendJson(404, "{\"ok\":false,\"error\":\"Эта прошивка принимает только картинки для экрана\"}"); });
    serverStarted = true;
  }
  server.begin();
  renderContent();
}

// ---------- Память настроек ----------
void saveState() {  // калькулятор
  prefs.begin("calc", false);
  prefs.putBool("ms", memSet);
  prefs.putBytes("mv", &memVal, sizeof(Val));
  prefs.putUChar("fmt", fmtMode);
  prefs.end();
}
void loadState() {
  prefs.begin("calc", true);
  memSet = prefs.getBool("ms", false);
  if (prefs.getBytes("mv", &memVal, sizeof(Val)) != sizeof(Val)) memSet = false;
  fmtMode = prefs.getUChar("fmt", 0) % 3;
  prefs.end();
}
bool lastFlip = false;
void saveSettings() {
  prefs.begin("school", false);
  prefs.putUChar("br", setBright);
  prefs.putUChar("dim", setDim);
  prefs.putUChar("th", setTheme);
  prefs.putBool("snd", setSound);
  prefs.putBool("flip", setFlip);
  prefs.end();
  if (setFlip != lastFlip) { lastFlip = setFlip; gfx->setRotation(setFlip ? 2 : 0); renderTabBar(); }
  if (!setSound && audioReady) ampEnable(false);
}
void loadSettings() {
  prefs.begin("school", true);
  setBright = std::max(5, std::min(100, (int)prefs.getUChar("br", 80)));
  setDim = prefs.getUChar("dim", 2) % 4;
  setTheme = prefs.getUChar("th", 0) % 6;
  setSound = prefs.getBool("snd", false);
  setFlip = prefs.getBool("flip", false);
  prefs.end();
  lastFlip = setFlip;
}
void resetAllSettings() {
  setBright = 80; setDim = 2; setTheme = 0; setSound = false; setFlip = false;
  applyTheme(0);
  applyBacklight();
  saveSettings();
  renderEverything();
}

void setup() {
  Serial.begin(115200);
  pinMode(PIN_BOOT, INPUT_PULLUP);
  pinMode(PIN_PWR, INPUT);
  Wire.begin(PIN_SDA, PIN_SCL);
  Wire.setClock(400000);
  resetPanelAndTouch();
  SPI.begin(18, 19, 23);
  if (!gfx->begin(40000000)) Serial.println("gfx->begin() failed!");
  loadSettings();
  gfx->setRotation(setFlip ? 2 : 0);
  gfx->fillScreen(C_BG);
  applyTheme(setTheme);
  if (!allInit()) { Serial.println("Out of memory"); while (true) delay(1000); }
  hv::hasPsram = psramFound();
  hv::imgCacheLimit = hv::hasPsram ? 400 * 1024 : 60 * 1024;
  loadState();
  renderEverything();
  applyBacklight();
  lastActivity = millis();
}

void loop() {
  uint32_t now = millis();
  // кнопки на плате: BOOT — «=» в калькуляторе, в остальных вкладках «назад»; PWR — формат результата
  static bool lastBoot = true, lastPwr = false;
  bool boot = digitalRead(PIN_BOOT), pwr = digitalRead(PIN_PWR);
  if (lastBoot && !boot) {
    lastActivity = now;
    if (dimmed) { dimmed = false; applyBacklight(); }
    else if (curTab == TAB_CALC) { onKey(K_EQ); renderDisplay(); renderSegments(); }
    else goBack();
  }
  if (!lastPwr && pwr && curTab == TAB_CALC) { onKey(K_BULB); renderDisplay(); lastActivity = now; }
  lastBoot = boot;
  lastPwr = pwr;

  // касания
  static int releaseCount = 0;
  static bool wake = false;
  TouchPt t;
  bool down = readTouch(t);
  if (down) {
    releaseCount = 0;
    lastActivity = now;
    if (!tDown && !wake) {
      if (dimmed) { dimmed = false; wake = true; applyBacklight(); }  // первое касание только будит экран
      else touchDown(t.x, t.y);
    } else if (tDown) {
      touchMove(t.x, t.y);
      if (curTab == TAB_CALC && downIdx >= 0 && keys[downIdx].id == K_BS && now >= nextRepeat) {
        onKey(K_BS); renderDisplay(); renderSegments(); nextRepeat = now + 110;
      }
    }
  } else if ((tDown || wake) && ++releaseCount >= 2) {
    wake = false;
    if (tDown) touchUp(tX0, tY0);
  }
  scrollTick();
  if (wifiOn) {
    server.handleClient();
    if (wifiApplyAt && (int32_t)(now - wifiApplyAt) >= 0) { wifiApplyAt = 0; wifiApplyHome(); if (curTab == TAB_SET && !castOn) renderContent(); }
    static uint32_t staCheck = 0;
    if (homeSsid.length() && now - staCheck > 500) {
      staCheck = now;
      bool up = WiFi.status() == WL_CONNECTED;
      if (up != staUp) {
        staUp = up;
        if (up && !mdnsUp && MDNS.begin("school")) { MDNS.addService("http", "tcp", 80); mdnsUp = true; }
        wifiInfoUpdate();
        if ((curTab == TAB_SET || (castOn && !castPx)) && !tDown) renderContent();
      }
    }
  }
  if (castReady && !tDown) {  // пришла картинка с телефона
    castReady = false;
    lastActivity = now;
    if (dimmed) { dimmed = false; applyBacklight(); }
    hv::evictImages(1u << 30);  // память под снимок важнее кэша картинок страницы
    bool justClosed = castClosedT && now - castClosedT < 4000;  // кадр отправили до того, как плата закрыла экран
    bool wasOn = castOn && castPx;
    if (!justClosed && castDecode(castRx.data(), castRx.size())) {
      castOn = true; castClosedT = 0; scrollVel = 0;
      if (wasOn) castRenderDiff(); else renderContent();
    }
    castRx.clear();
    castRx.shrink_to_fit();
  }

  if (castOn && !tDown && castTick(now)) renderRegion(CAST_TOP, CAST_BOT, drawTab);
  {  // телефон перестал забирать нажатия — убрать зелёную точку
    static bool linkedShown = false;
    bool l = castOn && castLinked();
    if (l != linkedShown) { linkedShown = l; if (castOn && !tDown) renderRegion(0, CAST_TOP, drawTab); }
  }
  // автопереход HTML-страниц (<meta http-equiv="refresh">)
  if (curTab == TAB_REF && rScr == R_HTML && !castOn && !tDown && hv::refreshAt && hv::tick()) { htmlSync(); lastActivity = now; renderContent(); }

  // мигание курсора калькулятора
  if (curTab == TAB_CALC && now - lastBlink >= 530) {
    lastBlink = now;
    cursorOn = !cursorOn;
    if (!justEval && !dimmed) renderDisplay();
  }
  // затемнение при простое
  static const uint32_t DIM_MS[4] = { 0, 30000, 60000, 300000 };
  if (!dimmed && setDim && now - lastActivity > DIM_MS[setDim]) { dimmed = true; applyBacklight(); }
  delay(8);
}
#endif
