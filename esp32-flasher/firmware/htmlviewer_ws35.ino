/*
  HTML Viewer для Waveshare ESP32-Touch-LCD-3.5
  (ESP32-D0WD-V3, 3.5" ST7796 320x480, тач FT6336, слот microSD)

  Открывает и показывает HTML-страницы с SD-карты прямо на экране платы:
    • текст с форматированием, заголовки, списки, таблицы, цитаты, код
    • картинки JPEG и PNG, ссылки между страницами и якоря (#раздел)
    • базовый CSS: цвета, фон, выравнивание, размер и начертание шрифта,
      отступы, скругления, display:none (теги, .классы, #id, атрибут style)
    • кодировки UTF-8 и windows-1251
    • <meta http-equiv="refresh" content="5; url=next.html"> — автопереход:
      так из страниц собирается слайд-шоу, которое «проигрывается» само
    • также открываются .txt, .jpg и .png
  JavaScript на экране платы не выполняется (на ESP32 не хватит памяти для
  браузерного движка). Для страниц с JS есть режим Wi-Fi: плата раздаёт
  файлы с карты, и телефон открывает их в своём браузере полностью,
  а ещё через него можно загружать новые файлы на карту.

  Управление: прокрутка пальцем, тап по ссылке, «‹» — назад,
  значок Wi-Fi — режим раздачи, BOOT — к списку файлов.
  Если на карте есть /index.html, он открывается при включении.
  Домашняя сеть вместо точки доступа: файл /wifi.txt (1-я строка — имя сети,
  2-я — пароль).

  Arduino IDE: плата "ESP32 Dev Module", PSRAM "Enabled",
  Partition Scheme "Huge APP (3MB No OTA/1MB SPIFFS)".
  Библиотеки: "GFX Library for Arduino", "JPEGDEC", "PNGdec".
  Шрифты Inter и DejaVu Sans Mono встроены (SIL OFL 1.1 / свободная лицензия DejaVu).
*/

#ifndef HOST_SIM
#include <Arduino_GFX_Library.h>
#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <WiFi.h>
#include <WebServer.h>
#endif
#include <JPEGDEC.h>
#include <PNGdec.h>
#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <string>
#include <vector>
#include <algorithm>

// ===================== Константы =====================
#define MK565(r, g, b) ((uint16_t)((((r) & 0xF8) << 8) | (((g) & 0xFC) << 3) | ((b) >> 3)))

#define SCREEN_W 320
#define SCREEN_H 480
#define BAR_H 44
#define VIEW_Y BAR_H
#define VIEW_H (SCREEN_H - BAR_H)
#define STRIP_H 32
#define PAGE_PAD 12
#define MAX_FILE_PSRAM (512 * 1024)
#define MAX_ITEMS 60000
#define MAX_FILE_NOPSRAM (96 * 1024)

#define C_BAR      MK565(18, 19, 24)
#define C_BAR_LINE MK565(48, 44, 62)
#define C_BAR_TEXT MK565(240, 240, 245)
#define C_BAR_ICON MK565(186, 140, 255)
#define C_BAR_DIM  MK565(110, 106, 130)

enum FontId : uint8_t { FN_BODY, FN_BOLD, FN_ITALIC, FN_BOLDIT, FN_MONO, FN_SMALL, FN_H3, FN_H2, FN_H1, FN_COUNT };
enum ItemType : uint8_t { DI_TEXT, DI_RECT, DI_IMG };
enum Align : uint8_t { AL_LEFT, AL_CENTER, AL_RIGHT };

// ===================== Типы =====================
// (все типы — до первой функции: так требует генератор прототипов Arduino)
struct Glyph { uint16_t cp; uint8_t w, h; int8_t xo, yo; uint8_t adv; uint32_t off; };
struct AAFont { uint8_t* bits; const Glyph* g; uint16_t n; int8_t asc, desc; const char* b64; uint32_t nbytes; };

struct Surface {
  uint16_t* px = nullptr;
  int w = 0, h = 0;
  int cx0 = 0, cy0 = 0, cx1 = 0, cy1 = 0;
};

// Элемент свёрстанной страницы
struct DItem {
  uint8_t type, font, flags, radius;  // flags: 1 — подчёркнуто, 2 — зачёркнуто
  uint16_t color;
  int16_t x, w, h;
  int32_t y;                          // текст: базовая линия; прямоугольник и картинка: верх
  uint32_t a;                         // текст: смещение в doc.text; картинка: номер в doc.imgs
  uint16_t len;
  int16_t link;
};

struct LinkBox { int16_t x, w, h; int32_t y; int16_t link; };
struct Anchor { std::string id; int32_t y; };

struct ImgEntry {
  std::string path;
  int16_t w, h, natW, natH;
  uint16_t* px;
  uint8_t state;          // 0 — не загружена, 1 — готова, 2 — ошибка
  uint8_t kind;           // 1 — JPEG, 2 — PNG
  uint32_t lastUse;
  uint16_t bg;
};

struct Doc {
  std::vector<DItem> items;
  std::string text;
  std::vector<LinkBox> boxes;
  std::vector<std::string> links;
  std::vector<Anchor> anchors;
  std::vector<ImgEntry> imgs;
  int32_t height = 0;
  uint16_t bg = 0xFFFF;
  std::string title;
  int refreshSec = 0;
  std::string refreshUrl;
  bool hasScript = false;
  bool truncated = false;
};

// Наследуемый стиль
struct Style {
  uint8_t bold, italic, mono, underline, strike, size;  // size: 0 мелкий, 1 обычный, 2..4 — h3..h1
  uint8_t align, pre, hidden;
  uint16_t color;
  int16_t link;
};

// Блочные свойства элемента из CSS
struct BoxProps {
  bool hasBg;
  uint16_t bg;
  int16_t pad, margin, radius, width;   // -1 — не задано; width < 0 в процентах: -100..-1
  bool widthPct;
};

struct Elem {
  char tag[12];
  Style st;
  bool block;
  BoxProps box;
  int itemStart;        // для фона блока
  int32_t startY;
  int16_t savedLeft, savedRight;
  int boxStart;         // для общей ссылки <a> вокруг блоков
  int listType;         // 1 — ul, 2 — ol
  int listCounter;
};

struct CssRule { std::string tag, cls, id; std::string decl; int spec; int order; };

struct Word {
  uint32_t a;
  uint16_t len;
  int16_t w;
  uint8_t font, flags;
  uint16_t color;
  int16_t link;
  bool space;
  int img;              // -1 — текст
  int16_t imgH;
};

struct CellBg { int itemIdx; int16_t x, w; uint16_t color; };

struct TableCtx {
  int ncols, col;
  int16_t x0, width, pad;
  int32_t rowTop, rowMax;
  int16_t savedLeft, savedRight;
  bool rowOpen, cellOpen, header;
  int cellItemStart;
  std::vector<CellBg> cellBgs;
  std::vector<int16_t> colEdges;
  bool cellHasBg;
  uint16_t cellBg;
  int16_t cellX, cellW;
};

struct DirEnt { std::string name; bool dir; uint32_t size; };

struct HistEntry { std::string url; int32_t scroll; };

struct TouchPt { int16_t x, y; };

// Состояние вёрстки
struct Layout {
  Doc* d;
  std::string baseDir;
  std::vector<Elem> stack;
  std::vector<CssRule> css;
  std::vector<TableCtx> tables;
  std::vector<Word> line;
  int16_t left, right;
  int32_t y;
  int pendingMargin;
  int lineW;
  uint8_t align;
  std::string marker;
  uint8_t markerFont;
  uint16_t markerColor;
  uint16_t textColor, linkColor;
  bool lastSpace;
  int cssOrder;
};

