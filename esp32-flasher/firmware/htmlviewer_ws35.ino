#ifndef HOST_SIM
#define PIN_SDA 21
#define PIN_SCL 22
#define PIN_BL 25
#define PIN_BOOT 0
#define PIN_SD_CS 15
#define TCA9554_ADDR 0x20
#define FT6336_ADDR 0x38

// Экран через SPIClass: так он делит шину SPI с SD-картой
Arduino_DataBus* bus = new Arduino_HWSPI(27 /* DC */, 5 /* CS */, 18 /* SCK */, 23 /* MOSI */, 19 /* MISO */, &SPI, true);
Arduino_GFX* gfx = new Arduino_ST7796(bus, GFX_NOT_DEFINED, 0, true);
WebServer server(80);
bool sdOk = false;

uint32_t nowMs() { return millis(); }

void pushPixels(int x, int y, int w, int h, const uint16_t* px) { gfx->draw16bitRGBBitmap(x, y, (uint16_t*)px, w, h); }

bool sdBegin() {
  if (sdOk) return true;
  sdOk = SD.begin(PIN_SD_CS, SPI, 20000000);
  return sdOk;
}

bool fsExists(const std::string& p) { return sdBegin() && SD.exists(p.c_str()); }

bool fsIsDir(const std::string& p) {
  if (!sdBegin()) return false;
  File f = SD.open(p.c_str());
  bool d = f && f.isDirectory();
  if (f) f.close();
  return d;
}

bool fsRead(const std::string& p, std::string& out, size_t maxLen, bool& truncated) {
  if (!sdBegin()) return false;
  File f = SD.open(p.c_str());
  if (!f || f.isDirectory()) return false;
  size_t size = f.size();
  truncated = size > maxLen;
  size_t n = std::min(size, maxLen);
  out.resize(n);
  size_t got = f.read((uint8_t*)&out[0], n);
  out.resize(got);
  f.close();
  return true;
}

bool fsList(const std::string& p, std::vector<DirEnt>& out) {
  if (!sdBegin()) { sdOk = false; return false; }
  File d = SD.open(p.c_str());
  if (!d || !d.isDirectory()) { sdOk = false; return false; }
  File f;
  while ((f = d.openNextFile())) {
    std::string name = f.name();
    size_t sl = name.rfind('/');
    if (sl != std::string::npos) name = name.substr(sl + 1);
    out.push_back({ name, f.isDirectory(), (uint32_t)f.size() });
    f.close();
    if (out.size() > 300) break;
  }
  d.close();
  return true;
}

void* fsOpen(const char* name, int32_t* size) {
  if (!sdBegin()) return nullptr;
  File* f = new File(SD.open(name));
  if (!*f) { delete f; return nullptr; }
  *size = f->size();
  return f;
}
void fsClose(void* h) { if (h) { File* f = (File*)h; f->close(); delete f; } }
int32_t fsReadCb(void* h, uint8_t* buf, int32_t len) { return h ? ((File*)h)->read(buf, len) : 0; }
bool fsSeek(void* h, int32_t pos) { return h && ((File*)h)->seek(pos); }

void tcaWrite(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(TCA9554_ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

void resetPanelAndTouch() {
  tcaWrite(0x01, 0xFF);
  tcaWrite(0x03, 0b11111100);
  tcaWrite(0x01, 0b11111100);
  delay(10);
  tcaWrite(0x01, 0xFF);
  delay(200);
}

bool readTouch(TouchPt& t) {
  Wire.beginTransmission(FT6336_ADDR);
  Wire.write(0x02);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((uint8_t)FT6336_ADDR, (uint8_t)5) != 5) return false;
  uint8_t d[5];
  for (int i = 0; i < 5; i++) d[i] = Wire.read();
  uint8_t n = d[0] & 0x0F;
  if (n == 0 || n > 2) return false;
  t.x = std::min(((d[1] & 0x0F) << 8) | d[2], SCREEN_W - 1);
  t.y = std::min(((d[3] & 0x0F) << 8) | d[4], SCREEN_H - 1);
  return true;
}

// ---------- Wi-Fi: раздача файлов с карты ----------
String mimeOf(const String& p) {
  String l = p;
  l.toLowerCase();
  if (l.endsWith(".html") || l.endsWith(".htm")) return "text/html; charset=utf-8";
  if (l.endsWith(".css")) return "text/css";
  if (l.endsWith(".js") || l.endsWith(".mjs")) return "text/javascript";
  if (l.endsWith(".json")) return "application/json";
  if (l.endsWith(".png")) return "image/png";
  if (l.endsWith(".jpg") || l.endsWith(".jpeg")) return "image/jpeg";
  if (l.endsWith(".gif")) return "image/gif";
  if (l.endsWith(".svg")) return "image/svg+xml";
  if (l.endsWith(".webp")) return "image/webp";
  if (l.endsWith(".ico")) return "image/x-icon";
  if (l.endsWith(".mp3")) return "audio/mpeg";
  if (l.endsWith(".wav")) return "audio/wav";
  if (l.endsWith(".mp4")) return "video/mp4";
  if (l.endsWith(".txt")) return "text/plain; charset=utf-8";
  if (l.endsWith(".woff2")) return "font/woff2";
  return "application/octet-stream";
}

void sendListing(const String& dir) {
  std::vector<DirEnt> ents;
  fsList(dir.c_str(), ents);
  std::sort(ents.begin(), ents.end(), [](const DirEnt& a, const DirEnt& b) { if (a.dir != b.dir) return a.dir; return lower(a.name) < lower(b.name); });
  String d = dir.endsWith("/") ? dir : dir + "/";
  String h = "<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>ESP32 SD</title>"
             "<style>body{font:16px system-ui,sans-serif;margin:0;padding:16px;background:#0e0f13;color:#ececf1}a{color:#c4a3ff;text-decoration:none}"
             "li{padding:10px 0;border-bottom:1px solid #2a2a33;list-style:none}ul{padding:0}small{color:#8e8aa6}"
             "form{margin:18px 0;padding:14px;background:#1a1b22;border-radius:12px}button{font:inherit;padding:8px 14px;border-radius:8px;border:0;background:#7b1fa2;color:#fff}</style>"
             "<h2>Карта: " + d + "</h2><ul>";
  if (d != "/") h += "<li><a href='" + String(resolvePath(d.c_str(), "..").c_str()) + "'>‹ Наверх</a></li>";
  for (auto& e : ents) {
    if (e.name.empty() || e.name[0] == '.' || e.name == "System Volume Information") continue;
    String full = d + e.name.c_str();
    if (e.dir) h += "<li><a href='" + full + "/'>📁 " + e.name.c_str() + "</a></li>";
    else h += "<li><a href='" + full + "'>" + e.name.c_str() + "</a> <small>" + fmtSize(e.size).c_str() + "</small></li>";
  }
  h += "</ul><form method=post enctype=multipart/form-data action='/__upload?dir=" + d + "'><b>Загрузить файлы сюда</b><br><br>"
       "<input type=file name=f multiple> <button>Загрузить</button></form>";
  server.send(200, "text/html; charset=utf-8", h);
}

void handleAny() {
  String path = server.uri();
  if (path.endsWith("/") || fsIsDir(path.c_str())) {
    String idx = (path.endsWith("/") ? path : path + "/") + "index.html";
    if (path != "/" && fsExists(idx.c_str())) path = idx;
    else { sendListing(path); return; }
  }
  if (!fsExists(path.c_str())) { server.send(404, "text/plain; charset=utf-8", "Нет такого файла: " + path); return; }
  File f = SD.open(path.c_str());
  server.streamFile(f, mimeOf(path));
  f.close();
}

File uploadFile;
void handleUpload() {
  HTTPUpload& up = server.upload();
  if (up.status == UPLOAD_FILE_START) {
    String dir = server.arg("dir");
    if (!dir.endsWith("/")) dir += "/";
    String name = up.filename;
    name.replace("/", "_");
    uploadFile = SD.open((dir + name).c_str(), FILE_WRITE);
  } else if (up.status == UPLOAD_FILE_WRITE) {
    if (uploadFile) uploadFile.write(up.buf, up.currentSize);
  } else if (up.status == UPLOAD_FILE_END || up.status == UPLOAD_FILE_ABORTED) {
    if (uploadFile) uploadFile.close();
  }
}

void wifiStart() {
  std::string cfg, ssid, pass;
  bool tr;
  wifiInfo.clear();
  if (fsRead("/wifi.txt", cfg, 512, tr)) {
    size_t nl = cfg.find('\n');
    ssid = trim(cfg.substr(0, nl));
    pass = nl == std::string::npos ? "" : trim(cfg.substr(nl + 1));
    size_t nl2 = pass.find('\n');
    if (nl2 != std::string::npos) pass = trim(pass.substr(0, nl2));
  }
  bool sta = false;
  if (!ssid.empty()) {
    WiFi.mode(WIFI_STA);
    WiFi.begin(ssid.c_str(), pass.c_str());
    uint32_t t0 = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - t0 < 12000) delay(200);
    sta = WiFi.status() == WL_CONNECTED;
  }
  String ip;
  if (sta) {
    ip = WiFi.localIP().toString();
    wifiInfo = "<h2>Wi-Fi включён</h2><p>Плата в сети <b>" + htmlEscape(ssid) + "</b>.</p><p>Откройте на телефоне в этой же сети:</p><p class='big'>http://" + std::string(ip.c_str()) + "</p>";
  } else {
    WiFi.mode(WIFI_AP);
    WiFi.softAP("ESP32-HTML", "12345678");
    ip = WiFi.softAPIP().toString();
    wifiInfo = std::string(ssid.empty() ? "" : "<p class='note'>Не удалось подключиться к сети из wifi.txt — включена своя точка доступа.</p>") +
               "<h2>Wi-Fi включён</h2><p>1. Подключите телефон к сети <b>ESP32-HTML</b>, пароль <b>12345678</b>.</p><p>2. Откройте в браузере:</p><p class='big'>http://" + std::string(ip.c_str()) + "</p>";
  }
  server.on("/__upload", HTTP_POST, []() { server.sendHeader("Location", server.arg("dir")); server.send(303); }, handleUpload);
  server.onNotFound(handleAny);
  server.begin();
  wifiOn = true;
}

void wifiStop() {
  server.stop();
  WiFi.softAPdisconnect(true);
  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
  wifiOn = false;
  barDirty = true;
}

// ---------- Касания и прокрутка ----------
bool touching = false, moved = false;
int16_t downX, downY, lastY;
int32_t downScroll;
uint32_t downT, lastMoveT;
float vel = 0;
int releaseCount = 0;

void setup() {
  Serial.begin(115200);
  pinMode(PIN_BOOT, INPUT_PULLUP);
  Wire.begin(PIN_SDA, PIN_SCL);
  Wire.setClock(400000);
  resetPanelAndTouch();
  SPI.begin(18, 19, 23);
  if (!gfx->begin(40000000)) Serial.println("gfx->begin() failed!");
  gfx->fillScreen(0x0000);
  analogWrite(PIN_BL, 230);
  hasPsram = psramFound();
  imgCacheLimit = hasPsram ? 700 * 1024 : 100 * 1024;
  if (!uiInit()) { Serial.println("Out of memory"); while (true) delay(1000); }
  sdBegin();
  if (fsExists("/index.html")) openUrl("/index.html", false);
  else openUrl("dir:/", false);
}

void loop() {
  uint32_t now = millis();
  if (wifiOn) server.handleClient();

  static bool lastBoot = true;
  bool boot = digitalRead(PIN_BOOT);
  if (lastBoot && !boot) { history.clear(); openUrl("dir:/", false); }
  lastBoot = boot;

  TouchPt t;
  bool down = readTouch(t);
  if (down) {
    releaseCount = 0;
    if (!touching) {
      touching = true; moved = false; vel = 0;
      downX = t.x; downY = lastY = t.y; downScroll = scrollY; downT = lastMoveT = now;
    } else if (downY >= BAR_H) {
      if (abs(t.y - downY) > 8 || abs(t.x - downX) > 8) moved = true;
      if (moved) {
        int32_t ns = downScroll - (t.y - downY);
        float dt = std::max<uint32_t>(1, now - lastMoveT);
        vel = 0.6f * vel + 0.4f * (-(t.y - lastY) / dt);
        lastY = t.y;
        lastMoveT = now;
        if (ns != scrollY) { scrollY = ns; viewDirty = true; }
      }
    }
  } else if (touching && ++releaseCount >= 2) {
    touching = false;
    if (!moved) {
      if (downY < BAR_H) {
        if (downX < 60) goBack();
        else if (downX > SCREEN_W - 60) { if (!wifiOn) { wifiStart(); openUrl("wifi:", true); } else openUrl("wifi:", true); }
      } else {
        tapAt(downX, scrollY + downY - VIEW_Y);
      }
    } else if (now - lastMoveT > 80) {
      vel = 0;
    }
  }

  if (!touching && fabsf(vel) > 0.05f) {  // инерция после свайпа
    static uint32_t lastFling = 0;
    uint32_t dt = lastFling ? std::min<uint32_t>(40, now - lastFling) : 16;
    lastFling = now;
    scrollY += (int32_t)(vel * dt);
    vel *= 0.92f;
    int32_t maxScroll = std::max<int32_t>(0, doc.height - VIEW_H);
    if (scrollY <= 0 || scrollY >= maxScroll) vel = 0;
    viewDirty = true;
    if (fabsf(vel) <= 0.05f) lastFling = 0;
  }

  if (refreshAt) {
    if ((int32_t)(now - refreshAt) >= 0) {
      std::string base = dirOf(curUrl);
      std::string next = resolvePath(base, urlDecode(doc.refreshUrl));
      openUrl(next, false);
    } else {
      static uint32_t lastBar = 0;
      if (now - lastBar > 200) { lastBar = now; barDirty = true; }
    }
  }
  if (viewDirty) renderView();
  if (barDirty) renderBar();
  delay(5);
}
#endif
