/*
  Калькулятор с дробями для Waveshare ESP32-Touch-LCD-3.5
  (ESP32-D0WD-V3, 3.5" ST7796 320x480, ёмкостный тач FT6336)

  Возможности:
    • Точные вычисления с дробями: 1/3 + 1/6 = 1/2 (без ошибок округления)
    • Ввод дробей: выберите «Числитель» или «Знаменатель» над клавиатурой
    • Скобки, √x, x², xⁿ, ±, %, память MC / MR / M+ / M−
    • Результат дробью, смешанным числом или десятичной (с периодом: 1/3 = 0,(3))
      — переключается лампочкой в углу экрана или кнопкой PWR
    • Память и формат сохраняются при выключении
    • Подсветка гаснет через минуту простоя, касание будит экран

  Физические кнопки: BOOT = «=», PWR (коротко) = формат результата.

  Arduino IDE:
    Плата: "ESP32 Dev Module"
    Библиотека: "GFX Library for Arduino" (moononournation)
    Шрифт Inter встроен в скетч (лицензия SIL OFL 1.1).
*/

#ifndef HOST_SIM
#include <Arduino_GFX_Library.h>
#include <Wire.h>
#include <Preferences.h>
#endif
#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// ===================== Константы =====================
#define MK565(r, g, b) ((uint16_t)((((r) & 0xF8) << 8) | (((g) & 0xFC) << 3) | ((b) >> 3)))

#define C_BG           MK565(0, 0, 0)
#define C_KEY          MK565(13, 13, 16)
#define C_KEY_DOWN     MK565(40, 31, 56)
#define C_BORDER       MK565(54, 50, 70)
#define C_PANEL        MK565(22, 23, 28)
#define C_PANEL_BORDER MK565(106, 52, 152)
#define C_DIGIT        MK565(244, 244, 247)
#define C_FUNC         MK565(169, 163, 217)
#define C_CLEAR        MK565(232, 41, 95)
#define C_EQ           MK565(123, 31, 162)
#define C_EQ_DOWN      MK565(152, 62, 192)
#define C_BULB         MK565(126, 59, 168)
#define C_DIM          MK565(138, 134, 160)
#define C_SEG_TEXT     MK565(154, 148, 196)
#define C_SEG_ON       MK565(42, 31, 61)
#define C_ACCENT       MK565(186, 140, 255)
#define C_ERR          MK565(255, 96, 116)
#define C_WHITE        MK565(255, 255, 255)

#define SCREEN_W 320
#define SCREEN_H 480
#define DISP_X 10
#define DISP_Y 10
#define DISP_W 300
#define DISP_H 118
#define SEG_X 10
#define SEG_Y 134
#define SEG_W 300
#define SEG_H 32
#define PAD_X 10
#define PAD_Y 172
#define PAD_W 300
#define KEY_H 46
#define ROW_PITCH 50
#define COL_GAP 6

#define MAIN_CAP 64
#define PART_CAP 24
#define FRAC_CAP 12

// Коды клавиш
enum KeyId : uint8_t {
  K_0, K_1, K_2, K_3, K_4, K_5, K_6, K_7, K_8, K_9,
  K_DOT, K_ADD, K_SUB, K_MUL, K_DIV, K_POW, K_SQR, K_PCT, K_LP, K_RP, K_SQRT, K_NEG, K_BS,
  K_C, K_EQ, K_MC, K_MR, K_MP, K_MM,
  K_SEG_MAIN, K_SEG_NUM, K_SEG_DEN, K_BULB, K_NONE = 255
};

enum : uint8_t { E_OK = 0, E_SYNTAX, E_DIV0, E_DOMAIN, E_OVER };
enum Target : uint8_t { TGT_MAIN, TGT_NUM, TGT_DEN };

// ===================== Типы =====================
// (все типы объявлены до первой функции — так требует генератор прототипов Arduino)
struct Glyph { uint16_t cp; uint8_t w, h; int8_t xo, yo; uint8_t adv; uint32_t off; };
struct AAFont { uint8_t* bits; const Glyph* g; uint16_t n; int8_t asc, desc; const char* b64; uint32_t nbytes; };

struct Surface {
  uint16_t* px = nullptr;
  int w = 0, h = 0, cap = 0;
  int cx0 = 0, cy0 = 0, cx1 = 0, cy1 = 0;  // область отсечения
};

// Элемент выражения: символ ('0'..'9', '.', '+', '-', '*', '/', '^', 's' = ², '%', '(', ')',
// 'r' = √, 'm' = унарный минус) или дробь ('F', f = номер дроби)
struct Item { char c; int8_t f; };
struct Part { Item it[PART_CAP]; uint8_t n; };
struct Frac { Part num, den; bool used; };
struct Field { Item* it; uint8_t* n; uint8_t cap; bool isMain; };

// Значение: точная дробь n/d или приближённое v
struct Val { bool exact; int64_t n, d; double v; bool pct; uint8_t err; };

struct Key { uint8_t id; int16_t x, y, w, h; };

struct TouchPt { int16_t x, y; };

struct Parser {
  const Item* it; int n; int p; uint8_t err;
  char peek() const { return p < n ? it[p].c : 0; }
  Val expr();
  Val term();
  Val unary();
  Val power();
  Val postfix();
  Val primary();
  Val number();
  Val fail(uint8_t e);
};

