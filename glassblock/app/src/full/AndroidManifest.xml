<?xml version="1.0" encoding="utf-8"?>
<!-- Только полная версия: доступ к уведомлениям, чтобы видеть, играет ли Яндекс Музыка, и управлять ею.
     В «лайт» этого сервиса нет — такие приложения Play Защита и прошивки не блокируют при установке. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".MusicListener"
            android:exported="true"
            android:label="@string/listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
