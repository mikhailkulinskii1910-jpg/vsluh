<?xml version="1.0" encoding="utf-8"?>
<!-- Пластинка, которую крутит ProgressBar виджета: уровень 0…10000 → поворот 0…360° вокруг центра. -->
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/disc_art"
    android:fromDegrees="0"
    android:pivotX="50%"
    android:pivotY="50%"
    android:toDegrees="360" />
