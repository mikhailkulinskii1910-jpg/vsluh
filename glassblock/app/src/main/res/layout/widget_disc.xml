<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет-плеер: пластинка в прозрачном боксе. Все слои — одинаковые квадраты (tools/make_disc.py),
     поэтому совпадают при любом размере виджета.
     Пауза — неподвижная пластинка (disc_still). Игра — неопределённый ProgressBar: сам лаунчер плавно
     поворачивает drawable/disc_spin (оборот за 1,92 с ≈ 31 об/мин), кадров и таймеров нет. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/disc_still"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/disc_art" />

    <ProgressBar
        android:id="@+id/disc_spin"
        style="@android:style/Widget.ProgressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:indeterminate="true"
        android:indeterminateBehavior="repeat"
        android:indeterminateDrawable="@drawable/disc_spin"
        android:indeterminateDuration="1920"
        android:indeterminateOnly="true"
        android:indeterminateTint="#FFFFFFFF"
        android:indeterminateTintMode="multiply"
        android:maxWidth="4000dp"
        android:maxHeight="4000dp"
        android:minWidth="1dp"
        android:minHeight="1dp"
        android:visibility="gone" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/disc_sheen" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/play_pause"
        android:scaleType="fitCenter"
        android:src="@drawable/case_front" />
</FrameLayout>
